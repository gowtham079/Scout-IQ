# =============================================================================
# ScoutIQ Environment Variables Template (.env.example)
#
# Copy this file to '.env' and provide your target environment configuration.
# DO NOT commit real secrets or production credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required for Backend & ETL Scripts)
# Used by: backend/app/database.py and src/config/settings.py
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scoutiq_user
MYSQL_PASSWORD=change_me_to_a_secure_password
MYSQL_DATABASE=scoutiq

# -----------------------------------------------------------------------------
# 2. BACKEND API & CORS CONFIGURATION (FastAPI Server)
# Used by: backend/app/main.py
# Comma-separated list of allowed frontend origins.
# In production, replace with your deployed frontend URL(s).
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 3. EXTERNAL DATA SOURCE / INGESTION (Optional for API Serving)
# Used by: src/api/sportmonks.py and src/ingestion/ pipelines.
# Required only when running ingestion scripts to fetch updates from Sportmonks.
# -----------------------------------------------------------------------------
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# -----------------------------------------------------------------------------
# 4. FRONTEND BUILD / CLIENT CONFIGURATION (Vite Client)
# Used by: frontend/src/api/client.js (inlined at build/serve time by Vite).
# In local development, leave empty or unset to default to '/api' (Vite proxy).
# In production (e.g., Vercel, Netlify), set to your deployed backend API URL.
# Example: https://api.scoutiq.example.com/api
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
